for %%x in (C:\Dungeon3dArt\ex\anim_barb_run_attack1_body_0000*.obj) do meshtool -transform %%x %%x -scale 10.0 10.0 10.0
for %%x in (C:\Dungeon3dArt\ex\anim_barb_run_attack1_axe_0000*.obj) do meshtool -transform %%x %%x -scale 10.0 10.0 10.0
copy C:\Dungeon3dArt\ex\anim_barb_run_attack1_body_0000*.obj C:\root\d4\d0814_2\_configs\
copy C:\Dungeon3dArt\ex\anim_barb_run_attack1_axe_0000*.obj C:\root\d4\d0814_2\_configs\
