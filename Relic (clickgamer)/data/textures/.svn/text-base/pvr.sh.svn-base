#!/bin/sh
#
for fname in ./*.png; do
   /Developer/Platforms/iPhoneOS.platform/Developer/usr/bin/texturetool -m -e PVRTC --bits-per-pixel-4 -f PVR -o $fname.pvrhi $fname
for fname in ./*.png; do
   /Developer/Platforms/iPhoneOS.platform/Developer/usr/bin/texturetool -m -e PVRTC --bits-per-pixel-2 -f PVR -o $fname.pvrlo $fname
done
done