<objects>

  <texture name="TopTile"   file="Top2" /> <!-- "TopTile3" -->
  <texture name="FloorTile" file="FloorStone3_14" /> <!-- "Floor_Ice", "FloorLava2", "Floor_Dirt" -->

  <object name="Empty">
    <mesh file="ex_Floor1~0" depth-write="false" test-visible="false" render-tag="level-floor">
      <texture file="Black" />
      <transform><scale x="0" y="0" z="0" /></transform>
    </mesh>
  </object>

  <object name="Floor"><object refers="Empty" /></object>

  <!-- Top -->
  <object name="Top">
    <mesh file="ex_Top0~0" test-visible="false" render-tag="level">
      <texture file="Top2" />
      <transform><scale x="1" y="1" z="1.5" /></transform>
