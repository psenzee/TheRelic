end

function ShowGenericDialog_Dismiss(text, title)
  local options = { { event = "GenericDialogDismiss", text = "Dismiss" } }  
  ShowGenericDialog(text, title, options)
end

function ShowJournalDialog_Dismiss(text, title, options)
  local options = { { event = "GenericDialogDismiss", text = "Dismiss" } }
  ShowJournalDialog(text, title, options)
end

function ShowImageDialog_Dismiss(image, options)
  local options = { { event = "GenericDialogDismiss", text = "Dismiss" } }
  ShowImageDialog(image, options)
end

function ShowScreenText(text, title)
  HideGenericDialog()
  local options = { { event = "GenericDialogDismiss", text = "Dismiss" } }
  GENERIC_DIALOG = CreateScreenDialog(text, title, true)
  UiControl_AddChild(CANVAS, GENERIC_DIALOG)
  SetSuppressHud(true)
  PROCESS_BUTTONS = false
  SetPaused(true)
end

function ShowImageDialog(image, options)
  HideGenericDialog()
  local options = { { event = "GenericDialogDismiss", text = "Dismiss" } }
  GENERIC_DIALOG = CreateImageDialog(image, options)
  UiControl_AddChild(CANVAS, GENERIC_DIALOG)
  SetSuppressHud(true)
  PROCESS_BUTTONS = false
  SetPaused(true)
end

function HideGenericDialog()
  if GENERIC_DIALOG ~= nil then
    UiControl_RemoveChild(CANVAS, GENERIC_DIALOG)
    UiControl_Destroy(GENERIC_DIALOG)
    GENERIC_DIALOG = nil
    SetSuppressHud(false)
    PROCESS_BUTTONS = true
    SetPaused(false)
    DequeueDialog()
  end
end


function QueueGenericDialog_Dismiss(...)
  QueueDialog(ShowGenericDialog_Dismiss, arg)
end

function QueueJournalDialog_Dismiss(...)
  QueueDialog(ShowJournalDialog_Dismiss, arg)
end

function QueueImageDialog_Dismiss(...)
  QueueDialog(ShowImageDialog_Dismiss, arg)
end

function QueueScreenText(...)
  QueueDialog(ShowScreenText, arg)
end

function DialogEventListener(info, data)
  if info == 'SELECTED' then
    if data.name == 'L1_Q_YesRing' then
      if GetInventoryItemCount(GetPlayer(), "RingQuest") == 0 then
        AddToInventory(GetPlayer(), "RingQuest", 1)
        AddToInventory(GetPlayer(), "KeyRed", 1)
      end
    elseif data.name == 'L1_Q_YesGenerator' then
      if GetInventoryItemCount(GetPlayer(), "Gen1Quest") == 0 then
        AddToInventory(GetPlayer(), "Gen1Quest", 1)
        --AddToInventory(GetPlayer(), "KeyWhite", 1)
      end
    end
  end
end

function GenericDialogListener(info, data)
  if info == 'SELECTED' then
    if data.name == 'GenericDialogDismiss' then
      HideGenericDialog()
    end
  end
end

function GetDialogTextString(dialogId)
  local text = LOCAL_GAME_STATE.DIALOG_TEXT[dialogId]
  if type(text) == 'table' then
    if IsAlreadyRead(dialogId) then
      text = text.AlreadyRead
    else
      text = text.NotRead
    end
  end
  return text
end

function IsQuestionAnswered(question)
  return LOCAL_GAME_STATE.QuestionsAnswered[question] == true
end

function SetQuestionAnswered(question)
  LOCAL_GAME_STATE.QuestionsAnswered[question] = true
end

function IsQuestionSelected(question)
  return LOCAL_GAME_STATE.QuestionsSelected[question] == true
end

function SetQuestionSelected(question)
  LOCAL_GAME_STATE.QuestionsSelected[question] = true
end

function IsAlreadyRead(answer)
  return LOCAL_GAME_STATE.AnswersRead[answer] == true
end

function SetAlreadyRead(answer)
  LOCAL_GAME_STATE.AnswersRead[answer] = true
end

function AreAllAnsweredRecurse(question, depth)
  if IsQuestionAnswered(question) then
    return true
  end
  local answer = LOCAL_GAME_STATE.DIALOG_ANSWERS[question]
  if #LOCAL_GAME_STATE.DIALOGS[answer] == 0 then
    if IsQuestionSelected(question) then
      SetQuestionAnswered(question)    
      return true
    end
    return false
  end
  for i, v in ipairs(LOCAL_GAME_STATE.DIALOGS[answer]) do
    if depth < 16 and not AreAllAnsweredRecurse(v, depth + 1) then
      return false
    end
  end
  if IsQuestionSelected(question) then
    SetQuestionAnswered(question)
  end
  return true
end

function AreAllAnswered(answered)
  return AreAllAnsweredRecurse(answered, 0)
end
--[[
DIALOG_TREE = nil
START_DIALOG_ID = "L1_A_IWait"
CURRENT_DIALOG_ID = START_DIALOG_ID
DIALOG_STACK = {}
]]--

function DestroyDialogTree()
  if DIALOG_TREE ~= nil then
    UiControl_RemoveChild(CANVAS, DIALOG_TREE)
    UiControl_Destroy(DIALOG_TREE)
    DIALOG_TREE = nil
  end
end

function StartDialog()
  PROCESS_BUTTONS = false
  SetPaused(true)
  SetDialogText(LOCAL_GAME_STATE.CURRENT_DIALOG_ID)
  SetSuppressHud(true)
end

function EndDialog()
  DestroyDialogTree()
  SetPaused(false)
  PROCESS_BUTTONS = true
  SetSuppressHud(false)
end

function SetDialogText(dialogId)
  if DIALOG_TREE ~= nil then
    DestroyDialogTree()
  end
  LOCAL_GAME_STATE.CURRENT_DIALOG_ID = dialogId
  DIALOG_TREE = CreateDialogTree(dialogId)
  SetAlreadyRead(dialogId)
end

function CreateDialogTree(dialogId)
  local dialogOptions = {}
  for i, v in ipairs(LOCAL_GAME_STATE.DIALOGS[dialogId]) do
    table.insert(dialogOptions, { event = v, text = LOCAL_GAME_STATE.DIALOG_OPTION_TEXT[v] })
  end
  local dialog = CreateDialog(GetDialogTextString(dialogId), "The Apparition Aos", IsAlreadyRead(dialogId), dialogOptions)
  UiControl_AddChild(CANVAS, dialog)
  return dialog
end

function DialogTreeListener(info, data)
  if info == 'SELECTED' then
    print ("Selected " .. data.name)
    if data.name == 'BACK' then
      if #LOCAL_GAME_STATE.DIALOG_STACK == 0 then
        LOCAL_GAME_STATE.CURRENT_DIALOG_ID = LOCAL_GAME_STATE.START_DIALOG_ID
        EndDialog()
      else
        LOCAL_GAME_STATE.CURRENT_DIALOG_ID = LOCAL_GAME_STATE.DIALOG_STACK[#LOCAL_GAME_STATE.DIALOG_STACK]
        table.remove(LOCAL_GAME_STATE.DIALOG_STACK, #LOCAL_GAME_STATE.DIALOG_STACK) -- pop
        SetDialogText(LOCAL_GAME_STATE.CURRENT_DIALOG_ID)
      end
    elseif data.name == 'LEAVE' then
      LOCAL_GAME_STATE.CURRENT_DIALOG_ID = LOCAL_GAME_STATE.START_DIALOG_ID
      EndDialog()
    else
      DialogEventListener(info, data)
      SetQuestionSelected(data.name)
      table.insert(LOCAL_GAME_STATE.DIALOG_STACK, LOCAL_GAME_STATE.CURRENT_DIALOG_ID) -- push
      LOCAL_GAME_STATE.CURRENT_DIALOG_ID = LOCAL_GAME_STATE.DIALOG_ANSWERS[data.name]
      SetDialogText(LOCAL_GAME_STATE.CURRENT_DIALOG_ID)
    end
  end
end  

function AddDialogOption(parent, item, y, width)
  local text = item.text
  if AreAllAnswered(item.event) then
    text = "\\#808080" .. text
  elseif IsQuestionSelected(item.event) then
    text = "\\#80ff80" .. text
  end
  local button = Ui_CreateButton(item.event, "bubbleborder", text, 0, y, width, y + 20, 1.0, 18.75)
  UiControl_AddChild(parent, button)
  RegisterUiListener(item.event, "DialogTreeListener",  { name = item.event })
end

function AddGenericDialogOption(parent, item, y, width)
  local text = item.text
  local button = Ui_CreateButton(item.event, "bubbleborder", text, 0, y, width, y + 20, 1.0, 18.75)
  UiControl_AddChild(parent, button)
  RegisterUiListener(item.event, "GenericDialogListener", { name = item.event })
end

function AddFinalDialogOption(parent, backEvent, nextEvent, y, width)
  local back = Ui_CreateButton(backEvent, "border88", "back",  0, y, width / 2 - 1, y + 20, 1.0, 18.75)
  local next = Ui_CreateButton(nextEvent, "border88", "leave", width / 2 + 1, y, width, y + 20, 1.0, 18.75)
  UiControl_AddChild(parent, back)
  UiControl_AddChild(parent, next)  
  RegisterUiListener(backEvent, "DialogTreeListener", { name = backEvent })
  RegisterUiListener(nextEvent, "DialogTreeListener", { name = nextEvent })
end

function CreateDialogOptionArea(options, x, y, width)
  local area = Ui_CreateMenu("..", "darkborder", "", x, 0, width, x, 1.0, 22.5)
  for i, value in ipairs(options) do
    AddDialogOption(area, value, y, width)
    y = y + 22
  end
  AddFinalDialogOption(area, "BACK", "LEAVE", y, width)
  return area
end

function CreateGenericDialogOptionArea(options, x, y, width)
  local area = Ui_CreateMenu("..", "darkborder", "", x, 0, width, x, 1.0, 22.5)
  for i, value in ipairs(options) do
    AddGenericDialogOption(area, value, y, width)
    y = y + 22
  end
  --AddFinalDialogOption(area, "BACK", "LEAVE", y, width)
  return area
end

function CreateDialog(text, characterName, alreadySeen, options)
  local screenwidth = 480
  local margin = 20
  local width = screenwidth - margin * 2
  local height = 280
  local dialogContainer   = Ui_CreateMenu("", "", "", margin, 20, screenwidth - margin, height, 1.0, 18.75)
  local dialogBackground1 = Ui_CreateButton("", "dropshadow", "",  5, 5, width, height, 1.0, 18.75)  
  local dialogBackground2 = Ui_CreateButton("", "darkborder", "", 0, 0, width, height, 1.0, 18.75)    
  local dialog            = Ui_CreateMenu("", "darkborder", "", 0, 0, width, 100, 1.0, 18.75)
  local titleControl      = Ui_CreateDialogText("", "\\#8080ff" .. characterName .. "\\#ffffff", 10, 20, 400, 100, 1.0, 22.5, false)
  local textControl       = nil
  
  if alreadySeen ~= true then
    textControl = Ui_CreateDialogText("", text, 10, 40, 400, 100, 1.0, 26.25, false)
  else
    textControl = Ui_CreateText("", text, 10, 40, 400, 100, 1.0, 26.25, false)  
  end
                            
  local buttonsMargin = 10
  local options = CreateDialogOptionArea(options, buttonsMargin, 190 - 22 * (#options - 3), width - buttonsMargin * 2)
  UiControl_SetActive(dialogBackground1, false)
  UiControl_SetActive(dialogBackground2, false)
  UiControl_AddChild(dialog, options)
  UiControl_AddChild(dialog, titleControl)  
  UiControl_AddChild(dialog, textControl)
  UiControl_AddChild(dialogContainer, dialogBackground1)
  UiControl_AddChild(dialogContainer, dialogBackground2)
  UiControl_AddChild(dialogContainer, dialog)
  return dialogContainer
end

function CreateGenericDialog(text, title, typewriterText, options)
  local screenwidth = 480
  local margin = 20
  local width = screenwidth - margin * 2
  local height = 280
  local dialogContainer   = Ui_CreateMenu("", "", "", margin, 20, screenwidth - margin, height, 1.0, 18.75)
  local dialogBackground1 = Ui_CreateButton("", "dropshadow", "",  5, 5, width, height, 1.0, 18.75)  
  local dialogBackground2 = Ui_CreateButton("", "darkborder", "", 0, 0, width, height, 1.0, 18.75)    
  local dialog            = Ui_CreateMenu("", "darkborder", "", 0, 0, width, 100, 1.0, 18.75)
  local titleControl      = Ui_CreateDialogText("", "\\#8080ff" .. title .. "\\#ffffff", 10, 20, 400, 100, 1.0, 22.5, false)
  local textControl       = nil
  
  if typewriterText then
    textControl = Ui_CreateDialogText("", text, 10, 40, 400, 100, 1.0, 26.25, false)
  else
    textControl = Ui_CreateText("", text, 10, 40, 400, 100, 1.0, 26.25, false)
  end
                            
  local buttonsMargin = 10
  local options = CreateGenericDialogOptionArea(options, buttonsMargin, 212 - 22 * (#options - 3), width - buttonsMargin * 2)
  UiControl_SetActive(dialogBackground1, false)
  UiControl_SetActive(dialogBackground2, false)
  UiControl_AddChild(dialog, options)
  UiControl_AddChild(dialog, titleControl)  
  UiControl_AddChild(dialog, textControl)
  UiControl_AddChild(dialogContainer, dialogBackground1)
  UiControl_AddChild(dialogContainer, dialogBackground2)
  UiControl_AddChild(dialogContainer, dialog)
  return dialogContainer
end

function CreateScreenDialog(text, title, typewriterText)
  local screenwidth = 480
  local margin = 20
  local width = screenwidth - margin * 2
  local height = 280
  local dialogContainer   = Ui_CreateMenu("", "", "", 0, 0, 480, 320, 1.0, 18.75)
  local dialogBackground1 = Ui_CreateButton("", "dropshadow", "",  -5, -5, 485, 325, 1.0, 18.75)
  local dialog            = Ui_CreateMenu("", "darkborder", "", 0, 0, width, 100, 1.0, 18.75)
  local titleControl      = Ui_CreateDialogText("", "\\#8080ff" .. title .. "\\#ffffff", 10, 30, 400, 100, 1.0, 30.0, false)  
  local textControl       = nil
  
  if typewriterText then
    textControl = Ui_CreateDialogText("", text, 10, 50, 400, 100, 1.0, 22.5, false)
  else
    textControl = Ui_CreateText("", text, 2, 2, 400, 100, 1.0, 20.625, false)  
  end
                            
  local buttonsMargin = 10
  UiControl_SetActive(dialogBackground1, false)
  UiControl_AddChild(dialog, titleControl)  
  UiControl_AddChild(dialog, textControl)
  UiControl_AddChild(dialogContainer, dialogBackground1)
  UiControl_AddChild(dialogContainer, dialog)
  return dialogContainer
end

function CreateImageDialog(image, options)  
  local screenwidth = 480
  local margin = 20
  local width = screenwidth - margin * 2
  local height = 280
  local dialogContainer   = Ui_CreateMenu("", "", "", 0, 0, 480, 320, 1.0, 18.75)
  local dialogBackground1 = Ui_CreateImageButton("", image, "", 0, 0, 480, 320, 1.0, 18.75, 0, 1, 1, 0, 0)
  local dialog            = Ui_CreateMenu("", "darkborder", "", 0, 0, 480, 320, 1.0, 18.75)
                            
  local buttonsMargin = 10
  local options = CreateGenericDialogOptionArea(options, buttonsMargin, 250 - 22 * (#options - 3), 480 - buttonsMargin * 2)
  UiControl_SetActive(dialogBackground1, false)
  UiControl_AddChild(dialog, options)
  UiControl_AddChild(dialogContainer, dialogBackground1)
  UiControl_AddChild(dialogContainer, dialog)
  return dialogContainer
end

