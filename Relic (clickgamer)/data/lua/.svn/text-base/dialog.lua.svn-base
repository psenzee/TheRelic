print "Lua:dialog.lua"

CANVAS = nil
GENERIC_DIALOG = nil
DIALOG_QUEUE = {}

function QueueDialog(fn, args)
  if GENERIC_DIALOG == nil then
    fn(unpack(args))
  else
    table.insert(DIALOG_QUEUE, { fn, args })
  end
end

function DequeueDialog()
  if #DIALOG_QUEUE ~= 0 then
    local invoke = DIALOG_QUEUE[1]
    table.remove(DIALOG_QUEUE, 1);
    (invoke[1])(unpack(invoke[2]));
  end
end

function ShowGenericDialog(text, title, options)
  HideGenericDialog()
  GENERIC_DIALOG = CreateGenericDialog(text, title, true, options)
  UiControl_AddChild(CANVAS, GENERIC_DIALOG)
  SetSuppressHud(true)
  PROCESS_BUTTONS = false
  SetPaused(true)
end

function ShowJournalDialog(text, title, options)
  HideGenericDialog()
  GENERIC_DIALOG = CreateJournalDialog(text, title, options)
  UiControl_AddChild(CANVAS, GENERIC_DIALOG)
  SetSuppressHud(true)
  PROCESS_BUTTONS = false
  SetPaused(true)
end

function ShowLoadGameDialog(text, title)
  HideGenericDialog()
  SetSuppressHud(true)
  PROCESS_BUTTONS = false
  SetPaused(true)  
  GENERIC_DIALOG = CreateLoadGameDialog(text, title)
