function GetRandomSpeed(hispeed)
  local lospeed = hispeed * 0.5
  if lospeed < 2.5 then -- we have a minimum speed
    lospeed = 2.5
  end
  return RandomBetween(lospeed, hispeed)
end

function GetRandomSpeedSeeded(seed, hispeed)
  local lospeed = hispeed * 0.5
  if lospeed < 2.5 then -- we have a minimum speed
    lospeed = 2.5
  end
  return RandomBetweenSeeded(seed, lospeed, hispeed)
end

math.randomseed(0)

_buttons = { false, false, false, false, 
             false, false, false, false, 
             false, false, false, false, 
             false, false, false, false }

_nextFrameButtons = { false, false, false, false, 
                      false, false, false, false, 
                      false, false, false, false, 
                      false, false, false, false }

function ClearButtonPresses()
  TOUCHED = false
  LOW_LEVEL_TOUCHED = false
  _G.THUMBSTICK_MOVEMENTS = {}
  touchBeganPoint = { 0, 0 }
  for i = 1,#_buttons do _buttons[i] = false end
  for i = 1,#_nextFrameButtons do _nextFrameButtons[i] = false end
end

function IsLocalButtonDown(index)
  return IsButtonDown(index) or _G._nextFrameButtons[index] or _G._buttons[index]
end

function ButtonPressed(index)
  local pressed = false
  if IsButtonDown(index) or _G._nextFrameButtons[index] then
    pressed = true
    _G._nextFrameButtons[index] = false
  end
  local buttons = _G._buttons;
  if not pressed then
    buttons[index] = false
  elseif buttons[index] then
    pressed = false
  else
    pressed = true
    buttons[index] = true
  end
  return pressed
end

function SetButtonPressed(index)
--_G._buttons[index] = true
  _G._nextFrameButtons[index] = true
end

function Random(variance)
  return math.random() * variance - (variance * 0.5)
end

function RandomSeeded(seed, variance)
  return Random_NextReal(seed) * variance - (variance * 0.5)
end

function RandomBetween(a, b)
  return math.random() * (b - a) + a
end

function RandomBetweenSeeded(seed, a, b)
  return Random_NextReal(seed) * (b - a) + a
end

-- this (or some variant) should be in C++
function GetWeighted(array, value)
  local count = #array
  local weight = 0.0
  for i = 1, count do
    weight = weight + array[i].weight
    if value <= weight then
        return array[i]
    end
  end
  return array[count]
end

