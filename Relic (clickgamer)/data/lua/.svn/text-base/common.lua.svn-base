INPUT_FRAME = 0
VECTOR_INPUT_THIS_FRAME = { 0.0, 0.0, 0.0 }
INTERNAL_VECTOR_INPUT = nil
INPUT_SCALE = 8.0

function SetInputDirection(x, y, z)
  local scale = _G.INPUT_SCALE
  if _G.INPUT_FRAME ~= GetGameStateFrames() then 
    _G.VECTOR_INPUT_THIS_FRAME = { x * scale, y * scale, z * scale }
    _G.INPUT_FRAME = GetGameStateFrames()
    _G.INTERNAL_VECTOR_INPUT = nil
  else
    _G.INTERNAL_VECTOR_INPUT = { x * scale, y * scale, z * scale }
  end
end

function GetInputDirection()
  if _G.INPUT_FRAME ~= GetGameStateFrames() then
    local scale = _G.INPUT_SCALE
    if _G.INTERNAL_VECTOR_INPUT ~= nil then
      _G.VECTOR_INPUT_THIS_FRAME = _G.INTERNAL_VECTOR_INPUT
      _G.INTERNAL_VECTOR_INPUT = nil
    else
      local x, y, z = GetVectorInput()	
      _G.VECTOR_INPUT_THIS_FRAME = { x * scale, y * scale, z * scale }
    end
    _G.INPUT_FRAME = GetGameStateFrames()
  end
  local inp = _G.VECTOR_INPUT_THIS_FRAME
  return v3Clamp(inp[1], inp[2], inp[3], -10.0, 10.0)  
end

function deepcopy(object)
    local lookup_table = {}
    local function _copy(object)
        if type(object) ~= "table" then
            return object
        elseif lookup_table[object] then
            return lookup_table[object]
        end
        local new_table = {}
        lookup_table[object] = new_table
        for index, value in pairs(object) do
            new_table[_copy(index)] = _copy(value)
        end
        return setmetatable(new_table, getmetatable(object))
    end
    return _copy(object)
end

function deepcopyinto(object, into)
  for index, value in pairs(object) do
    into[deepcopy(index)] = deepcopy(value)
  end
  return setmetatable(into, getmetatable(object))
end

LOMEM = 1000000000

function UpdateMemoryStats()
  local free = GetFreeMemory()
  if ReceivedLowMemoryWarning() then
    if free < LOMEM then
	  LOMEM = free
	end    
  end
end