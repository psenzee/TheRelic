print "Lua:trailer.lua"

function NewXSequence(sequence, delay)
  local state = {}
  state.sequence = sequence
  state.startTime = 0
  state.count = 1
  state.frameCount = 0
  return state  
end

MAX_TRANSITION_FRAMES = 20

function IsXSequenceDone(state)
  return state == nil or state.count > #state.sequence
end

function DrawXSequence(state, baseAlpha)
  if state.count > #state.sequence then
    return
  end
  if state.startTime == 0 or state.startTime == nil then
    state.startTime = GetTime()
  end
  local expectedTime = state.sequence[state.count].time
  if (GetTime() - state.startTime >= expectedTime) then
    state.frameCount = 0
    state.count = state.count + 1
  end
  state.frameCount = state.frameCount + 1
  if (state.frameCount > MAX_TRANSITION_FRAMES) then
    state.frameCount = MAX_TRANSITION_FRAMES
  end
  local alpha = 1.0 - (MAX_TRANSITION_FRAMES - state.frameCount) / MAX_TRANSITION_FRAMES
  if state.count <= #state.sequence then
    if state.count > 1 then
      DrawBackgroundScroll((1.0 - alpha) * baseAlpha, state.sequence[state.count - 1].name, 0)
    end
    DrawBackgroundScroll(alpha * baseAlpha, state.sequence[state.count].name, 0)
  end
end

local pics = { { name="Black",        time= 2000 },
               { name="trailerPic1b", time= 4000 },
               { name="trailerPic2c", time=16000 },
               { name="trailerPic3b", time=18000 },
               { name="Black",        time=20000 } }
               
local trailerPics  = nil

function ResetTrailer()
  trailerPics  = NewXSequence(pics, 2000)
end

function DrawTrailer()
  DrawBackground(1.0, "intro10c")
--[[
  if IsXSequenceDone(trailerPics) then
    return
  end

  DrawBackground(1.0, "intro10c")
  DrawXSequence(trailerPics, 0.35)
]]--
end