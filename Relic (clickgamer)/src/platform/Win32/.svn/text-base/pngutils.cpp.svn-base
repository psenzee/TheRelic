//#include <unistd.h>
#include <windows.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <stdarg.h>

#include <math.h>

#define PNG_DEBUG 3
#include <png.h>

#include "pngutils.h"

struct PngFile
{
    int         width,
                height;
    png_byte    color_type;
    png_byte    bit_depth;

    png_structp png_ptr;
    png_infop   info_ptr;
    int         number_of_passes;
    png_bytep  *row_pointers;
};

static void destroy(PngFile *pf)
{
    for (int y = 0; y < pf->height; y++)
        free(pf->row_pointers[y]);
    free(pf->row_pointers);
    memset(pf, 0, sizeof(PngFile));
}

void copy_rgb_to_rgba(png_byte *from, png_byte *to, int width, png_byte alpha)
{
    for (int i = 0; i < width; i++)
    {
        to[0] = from[0];
        to[1] = from[1];
        to[2] = from[2];
        to[3] = alpha;
        to   += 4;
        from += 3;
    }
}

bool read_png_file(const char *file_name, PngFile *pf)
{
    int y = 0;
    char header[8];    // 8 is the maximum size that can be checked

    /* open file and test for it being a png */
    FILE *fp = fopen(file_name, "rb");
    if (!fp)
    {
        fprintf(stderr, "[read_png_file] File %s could not be opened for reading\n", file_name);
        return false;
    }
    fread(header, 1, 8, fp);
    if (png_sig_cmp((png_bytep)header, 0, 8))
    {
        fprintf(stderr, "[read_png_file] File %s is not recognized as a PNG file\n", file_name);
        return false;
    }

    /* initialize stuff */
    pf->png_ptr = png_create_read_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
    
    if (!pf->png_ptr)
    {
        fprintf(stderr, "[read_png_file] png_create_read_struct failed\n");
        return false;
    }

    pf->info_ptr = png_create_info_struct(pf->png_ptr);
    if (!pf->info_ptr)
    {
        fprintf(stderr, "[read_png_file] png_create_info_struct failed\n");
        return false;
    }

    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[read_png_file] Error during init_io\n");
        return false;
    }

    png_init_io(pf->png_ptr, fp);
    png_set_sig_bytes(pf->png_ptr, 8);

    png_read_info(pf->png_ptr, pf->info_ptr);

    pf->width = pf->info_ptr->width;
    pf->height = pf->info_ptr->height;
    pf->color_type = pf->info_ptr->color_type;
    pf->bit_depth = pf->info_ptr->bit_depth;
    
    bool hasalpha = (pf->color_type & PNG_COLOR_MASK_ALPHA) != 0;

    // $senzee
    if (pf->bit_depth == 16)
        png_set_strip_16(pf->png_ptr);
    if (pf->color_type == PNG_COLOR_TYPE_GRAY || pf->color_type == PNG_COLOR_TYPE_GRAY_ALPHA)
        png_set_gray_to_rgb(pf->png_ptr);
    if (pf->color_type == PNG_COLOR_TYPE_PALETTE)
        png_set_palette_to_rgb(pf->png_ptr);
    if (png_get_valid(pf->png_ptr, pf->info_ptr, PNG_INFO_tRNS))
    {
        hasalpha = true;
        png_set_tRNS_to_alpha(pf->png_ptr);
    }
    /*
    // $senzee strip out alpha?
    if (color_type & PNG_COLOR_MASK_ALPHA)
        png_set_strip_alpha(png_ptr);
    */
    int rowbytes = pf->width * 4; // always reserve enough for RGBA

    pf->number_of_passes = png_set_interlace_handling(pf->png_ptr);
    png_read_update_info(pf->png_ptr, pf->info_ptr);

    /* read file */
    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[read_png_file] Error during read_image\n");
        return false;
    }

    pf->row_pointers = (png_bytep *)malloc(sizeof(png_bytep) * pf->height);
    for (y = 0; y < pf->height; y++)
        pf->row_pointers[y] = (png_byte *)malloc(rowbytes);
    png_read_image(pf->png_ptr, pf->row_pointers);
    pf->bit_depth  = 8;
    pf->color_type = PNG_COLOR_TYPE_RGBA;
    if (!hasalpha)
    {
        png_byte *tmp = (png_byte *)malloc(rowbytes);
        for (y = 0; y < pf->height; y++)
        {
            copy_rgb_to_rgba(pf->row_pointers[y], tmp, pf->width, 255);
            memcpy(pf->row_pointers[y], tmp, pf->width * 4);
        }
        free(tmp);
    }
    fclose(fp);
    return true;
}

bool read_png_file(const char *filename, Image *image, bool flipVertical)
{
    PngFile pf;
    bool success = read_png_file(filename, &pf);
    if (!success)
    {
        printf("Failed to load image '%s'\n", filename);
        // $TODO be more vigilant about what needs to be cleaned up here
        return false;
    }
    if (pf.width <= 0 || pf.height <= 0)
    {
        printf("Image height and/or width do not appear to be correct for '%s'\n", filename);
        destroy(&pf);        
        return false;        
    }/*
    if (pf.bit_depth != 32)
    {
        printf("Bit depth must be 32 for image '%s', is %d\n", filename, pf.bit_depth);
        destroy(&pf);
        return false;        
    }*/
    image->width  = pf.width;
    image->height = pf.height;
    image->data   = new char [pf.height * pf.width * 4];
    if (!flipVertical)
    {
       for (int y = 0; y < pf.height; y++)
           memcpy(image->data + y * pf.width * 4, pf.row_pointers[y], pf.width * 4);
    }
    else
    {
       for (int y = 0; y < pf.height; y++)
           memcpy(image->data + y * pf.width * 4, pf.row_pointers[pf.height - 1 - y], pf.width * 4);        
    }
    destroy(&pf);
    return true;
}

void write_png_file(const char *file_name, PngFile *pf)
{
    int y = 0;

    /* create file */
    FILE *fp = fopen(file_name, "wb");
    if (!fp)
    {
        fprintf(stderr, "[write_png_file] File %s could not be opened for writing\n", file_name);
        exit(-1);
    }

    /* initialize stuff */
    pf->png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, NULL, NULL, NULL);
    
    if (!pf->png_ptr)
    {
        fprintf(stderr, "[write_png_file] png_create_write_struct failed\n");
        exit(-1);
    }

    pf->info_ptr = png_create_info_struct(pf->png_ptr);
    if (!pf->info_ptr)
    {
        fprintf(stderr, "[write_png_file] png_create_info_struct failed\n");
        exit(-1);
    }

    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[write_png_file] Error during init_io\n");
        exit(-1);
    }

    png_init_io(pf->png_ptr, fp);

    /* write header */
    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[write_png_file] Error during writing header\n");
        exit(-1);
    }

    png_set_IHDR(pf->png_ptr, pf->info_ptr, pf->width, pf->height,
             pf->bit_depth, pf->color_type, PNG_INTERLACE_NONE,
             PNG_COMPRESSION_TYPE_BASE, PNG_FILTER_TYPE_BASE);

    png_write_info(pf->png_ptr, pf->info_ptr);


    /* write bytes */
    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[write_png_file] Error during writing bytes\n");
        exit(-1);
    }

    png_write_image(pf->png_ptr, pf->row_pointers);


    /* end write */
    if (setjmp(png_jmpbuf(pf->png_ptr)))
    {
        fprintf(stderr, "[write_png_file] Error during end of write\n");
        exit(-1);
    }

    png_write_end(pf->png_ptr, NULL);

        /* cleanup heap allocation */
    for (y=0; y < pf->height; y++)
        free(pf->row_pointers[y]);
    free(pf->row_pointers);

    fclose(fp);
}

void write_png_file(const char *file_name, int width, int height, const int *data)
{
    PngFile pf;

    pf.width = width; pf.height = height;
    pf.bit_depth  = 8;
    pf.color_type = PNG_COLOR_TYPE_RGBA;

    int rowbytes = pf.width * 4; // always reserve enough for RGBA
    pf.row_pointers = (png_bytep *)malloc(sizeof(png_bytep) * pf.height);
    for (int y = 0; y < pf.height; y++)
    {
        pf.row_pointers[y] = (png_byte *)malloc(rowbytes);
        memcpy(pf.row_pointers[y], data + y * pf.width, rowbytes);
    }

    write_png_file(file_name, &pf);
}

png_byte compute_alpha(png_byte *colora, png_byte *colorb)
{
    static float SQRT_3 = sqrtf(3.0f);

    if (colora[0] == colorb[0] && 
        colora[1] == colorb[1] &&
        colora[2] == colorb[2])
        return 255;

    float ar = colora[0] / 255.0f, ag = colora[1] / 255.0f, ab = colora[2] / 255.0f,
          br = colorb[0] / 255.0f, bg = colorb[1] / 255.0f, bb = colorb[2] / 255.0f;

    float ma = sqrtf(ar * ar + ag * ag + ab * ab), // a crappy grayscle
          mb = sqrtf(br * br + bg * bg + bb * bb); // a crappy grayscle

//    if ((mb - ma) < 0.0f)
//        return 255.0f;

    float v  = 1.0f - (fabsf(mb - ma) / SQRT_3);

    return (png_byte)(unsigned)(v * 255.0f);
}

void process_file(PngFile *pfa, PngFile *pfb)
{
    int x, y;

    if (pfa->width != pfb->width || pfa->height != pfb->height)
    {
        fprintf(stderr, "[process_file] width and height of input files must match exactly\n");
        exit(-1);
    }

    for (y=0; y < pfa->height; y++)
    {
        png_byte *rowa = pfa->row_pointers[y],
                 *rowb = pfb->row_pointers[y];
        for (x=0; x < pfa->width; x++)
        {
            png_byte *ptra = &(rowa[x*4]),
                     *ptrb = &(rowb[x*4]);

            ptra[3] = compute_alpha(ptra, ptrb);
        }
    }
}

void save_raw_file(PngFile *pf, const char *filename, bool header)
{
    FILE *file = fopen(filename, "wb");

    int x, y;

    int height = pf->height, width = pf->width;

    if (header)
    {
        fwrite(&width,  sizeof(width),  1, file);
        fwrite(&height, sizeof(height), 1, file);
    }

    for (y = 0; y < pf->height; y++)
    {
        png_byte *row = pf->row_pointers[y];
        for (x = 0; x < pf->width; x++)
        {
            png_byte *ptr = &(row[x * 4]);
            fwrite(ptr, 1, 4, file);
        }
    }

    fclose(file);
}

int combine(int argc, const char **argv)
{
    if (argc != 5)
    {
        fprintf(stderr, "Usage: %s -combine <black-file-in> <white-file-in> <file-out>\n", argv[0]);
        fprintf(stderr, "       (for the -combine option)\n", argv[0]);
        return -1;
    }
    PngFile pfa, pfb;
    read_png_file(argv[2], &pfa);
    read_png_file(argv[3], &pfb);
    process_file(&pfa, &pfb);
    write_png_file(argv[4], &pfa);
    return 0;
}

int write_raw(int argc, const char **argv)
{
    if (argc < 4)
    {
        fprintf(stderr, "Usage: %s -raw [-noheader] <png-file-in> <raw-file-out>\n"
                        "       (for the -raw option)\n", argv[0]);
        return -1;
    }
    int  option = 2;
    bool header = true;
    if (stricmp(argv[option], "-noheader") == 0)
    {
        option++;
        header = false;
    }
    PngFile pf;
    read_png_file(argv[option++], &pf);
    save_raw_file(&pf, argv[option++], header);
    return 0;
}

int write_png(int argc, const char **argv)
{
    if (argc < 4)
    {
        fprintf(stderr, "Usage: %s -png <raw-file-in> <png-file-out>\n"
                        "       (for the -png option)\n", argv[0]);
        return -1;
    }
    int option = 2, width = 0, height = 0;
    const char *raw_file_in = argv[option++];

    FILE *file = fopen(raw_file_in, "rb");
    if (!file)
    {
        fprintf(stderr, "Unable to open input file '%s'\n", argv[0]);
        return -1;
    }
    if (!fread(&width,  1, sizeof(int), file) || 
        !fread(&height, 1, sizeof(int), file))
    {
        fprintf(stderr, "Unable to read input file '%s'\n", argv[0]);
        fclose(file);
        return -1;
    }
    int *data = new int [width * height];
    if (!fread(data, 1, width * height * sizeof(int), file))
    {
        fprintf(stderr, "Unable to read input file '%s'\n", argv[0]);
        delete [] data;
        fclose(file);
        return -1;
    }

    write_png_file(argv[option++], width, height, data);
    delete [] data;
    return 0;
}

void copy(PngFile &pf, int width, int height, int x, int y, int *data)
{
    memset(data, 0, width * height * sizeof(int));
    if (pf.width - x < width)
        width = pf.width - x;
    if (pf.height - y < height)
        height = pf.height - y;
    for (int j = 0; j < height; j++)
        memcpy(data + (j * width), pf.row_pointers[j + y] + x * sizeof(int), width * sizeof(int));
}

int slice_png(int argc, const char **argv)
{
    int slicewidth = 0, sliceheight = 0;
    if (argc < 5 || (slicewidth = atoi(argv[3])) <= 0 || (sliceheight = atoi(argv[4])) <= 0)
    {
        fprintf(stderr, "Usage: %s -slice <png-file> <slice-width> <slice-height>\n"
                        "       (for the -slice option)\n", argv[0]);
        return -1;
    }
    const char *png_file_in = argv[2];
    PngFile pf;
    read_png_file(png_file_in, &pf);
    char pngfile[1024], filename[1024];
    strcpy(pngfile, png_file_in);
    char *period = 0;
    if ((period = strrchr(pngfile, '.')) != 0)
        *period = 0;
    int *data = new int [slicewidth * sliceheight];
    int count = 0;
    for (int j = 0; j < pf.height; j += sliceheight)
    {
        for (int i = 0; i < pf.width; i += slicewidth)
        {
            copy(pf, slicewidth, sliceheight, i, j, data);
            sprintf(filename, "%s_%d.png", pngfile, count++);
            write_png_file(filename, slicewidth, sliceheight, data);
        }
    }
    delete [] data;
    return 0;
}
