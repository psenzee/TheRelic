{
    Character *instance  = GetCharacter(lua);
    float      distance  = GetFloat(lua, -1),
               hp        = GetFloat(lua, -2);
    Character *from      = GetCharacter(lua, -3);
    ReceiveHitInMotion(instance, from, hp, distance);
    return 0;
}

