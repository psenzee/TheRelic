	[CrystalSession initWithAppID:@"1374239207" delegate:self version:1.0 theme:@"Indigo_007" secretKey:@"p5ms0ns0bjjtld79vl2hbs0onobt67"];
	[CrystalSession lockToOrientation:UIDeviceOrientationLandscapeRight];	
}

