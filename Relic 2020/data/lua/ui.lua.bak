function EnableProcessButtons()
  PROCESS_BUTTONS = true
end

function DoFlash(time)
  if FLASH_START == nil then
    FLASH_START = GetTime()
    FLASH_END = FLASH_START + time
  end
  LIGHTNESS_LEVEL = 1.0
  SetOverlayColor(FADE_R, FADE_G, FADE_B, 1.0)
end

DARKNESS_LEVEL = 0.0
LIGHTNESS_LEVEL = 0.0
LIGHTNESS_LEVEL_OVERRIDE = 0.0
BACKGROUND_LEVEL = 0.0

function SetLightness(level)
  LIGHTNESS_LEVEL = level
end

function SetLightnessOverride(level)
  LIGHTNESS_LEVEL_OVERRIDE = level
end

function SetBackgroundLevel(level)
  BACKGROUND_LEVEL = level
end

function SetDarkness(level)
  DARKNESS_LEVEL = level
end

FADE_R = 1.0
FADE_G = 1.0
FADE_B = 1.0

function SetFadeColor(r, g, b)
  FADE_R = r
  FADE_G = g
  FADE_B = b
end

function UpdateOverlays()
  LIGHTNESS_LEVEL = 0.0
  if FLASH_START ~= nil then
    local time = GetTime()
    if time >= FLASH_END then
      FLASH_START = nil
      FLASH_END   = nil
    else
      local at = 1.0 - (time - FLASH_START) / (FLASH_END - FLASH_START)
      if at > 0.1 and at < 1.01 then
        LIGHTNESS_LEVEL = at        
      end
    end
  end
  SetOverlayColor(FADE_R, FADE_G, FADE_B, 0.0)

  if LIGHTNESS_LEVEL + LIGHTNESS_LEVEL_OVERRIDE > 0.1 then
    --DrawBackground(LIGHTNESS_LEVEL, "white")
    SetOverlayColor(FADE_R, FADE_G, FADE_B, LIGHTNESS_LEVEL + LIGHTNESS_LEVEL_OVERRIDE)
  end
  if DARKNESS_LEVEL > 0.1 then
    DrawBackground(DARKNESS_LEVEL, "Black")
  end
  if BACKGROUND_LEVEL > 0.1 then
    DrawBackgroundPartial(BACKGROUND_LEVEL, "background_partial") 
  end  
end

function EndCredits()
  DoFlash(2000)
  ShowMainMenu()
end

function UpdateCreditScroll()
  if CREDITS_SCREEN ~= nil and UiControl_IsVisible(CREDITS_SCREEN) then
    if CREDIT_SCROLL == nil then
      ResetCreditScroll()
    end
    local x0, y0, x1, y1 = UiControl_GetBounds(CREDITS_SCREEN)
    local dy = y1 - y0
    UiControl_RequestBounds(CREDITS_SCREEN, x0, CREDIT_SCROLL, x1, CREDIT_SCROLL + dy)
    if CREDIT_SCROLL < -650 then
      _SetVisible(CREDITS_DISMISS_BG, true)
      ShowAchievement("Credits")
    end    
    if CREDIT_SCROLL > -900 then
      CREDIT_SCROLL = CREDIT_SCROLL - 0.75
    end
  --if CREDIT_SCROLL <= -900 then EndCredits() end
  end
end

function tmp_GetPlayerId()
  local c = GetPlayer()
  if c == nil then
    return -1
  end
  return c:GetId()
end

function tmp_GetConnectionIds()
  local count = Multiplayer_GetConnectionCount()
  local text = "["
  for index = 1,count do
    if #text > 1 then
      text = text .. "/"
    end
    local id = Multiplayer_GetIdByIndex(index - 1)
    text = text .. tostring(id)
  end
  return text .. "]"
end

  
BUTTON_AREAS =
{
  {   0, 380,  58, 479 }, -- button 0
--{   0, 380,  58, 430 }, -- button 0
  { 128, 424, 196, 479 }, -- button 1
  {  53, 424, 112, 479 }, -- button 2
--{ 260, 424, 300, 479 }, -- button 3
  {   0, 0, 1, 1 }, -- button 3
  { 100, 180, 280, 300 }, -- button 4
  
--{   0, 430,  58, 479 }, -- button 5
  {   0, 0, 1, 1 }, -- button 5
}


function UiUpdateAndRender(instance)

  UpdateErrorOccurred("\\#ff00ff")
  UpdateMemoryStats()

  if not WAS_INTRO_SEQUENCE_DONE and IsIntroSequenceDone() then
    SetGameStateId(GAMESTATE_MENU)
    WAS_INTRO_SEQUENCE_DONE = true
    DeferByTimeMs(100, "EnableProcessButtons")   
    SetSuppressHud(false)
    DrawIntroSequence() -- make sure we don't have an empty frame
    UnloadSequenceTextures()
  end  
  
  if not IS_STARTED or not IsIntroSequenceDone() then
    DrawIntroSequence()
    if not IS_STARTED then
      DrawLoading()
    else
      SetPaused(true)
      SetSuppressHud(true)
    end
    return
  else
    DISABLE_UI_INPUT = false
  end

  DrawSequence()
  
  UpdateHud()

  if SET_UNPAUSED == nil then
    SetPaused(false)
    SetRenderPaused(false)
    SET_UNPAUSED = true
  end
  
  local player = GetPlayer()
  
  DrawHud(player)
  DrawLevelUp(player)
  UpdateOverlays()
  UpdateCreditScroll()
  
  --DrawTmp(10, 10, 470, 310)
  
  DrawTmp(THUMBSTICK[2] - 50, 320 - (THUMBSTICK[1] - 50) + 20, THUMBSTICK[2] + 50, 320 - (THUMBSTICK[1] + 50) + 20) 
  
  for i, value in ipairs(BUTTON_AREAS) do
    local y1 = 320 - value[1]
	local y2 = 320 - value[3]
	if y1 < 160 then y1 = y1 - 20; end
	if y1 > 160 then y1 = y1 + 20; end
	if y2 < 160 then y2 = y2 - 20; end
	if y2 > 160 then y2 = y2 + 20; end	
    DrawTmp(value[2], y1, value[4], y2)
  end
  
  if IsMapOn() then
--  DrawCanvas(1.0)
  end    
  
end