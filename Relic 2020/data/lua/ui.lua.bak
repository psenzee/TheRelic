SET_UNPAUSED = nil
WAS_INTRO_SEQUENCE_DONE = false

GAMESTATE_UNKNOWN             = 0
GAMESTATE_PRELOAD             = 1
GAMESTATE_SEQUENCE            = 2
GAMESTATE_MENU                = 3
GAMESTATE_LOADING_OUT_OF_MENU = 4
GAMESTATE_STARTNEW            = 5
GAMESTATE_LOAD                = 6
GAMESTATE_STARTED             = 7
GAMESTATE_JOIN                = 8
GAMESTATE_INGAME              = 9
GAMESTATE_LOADING             = 10
GAMESTATE_LOADED              = 11
GAMESTATE_UNLOADING           = 12
GAMESTATE_UNLOADING_PLAYERS   = 13
GAMESTATE_UNLOADED            = 14
GAMESTATE_JOINING             = 15
GAMESTATE_DESERIALIZED        = 16

function IsInLoadingState()
  local state = GetGameStateId()
  return state ~= GAMESTATE_SEQUENCE and
         state ~= GAMESTATE_MENU     and
         state ~= GAMESTATE_INGAME
end

function IntroComplete()
  ShowMainMenu()
end

