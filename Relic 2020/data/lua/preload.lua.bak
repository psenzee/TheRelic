function CanUpdateMultiplayer()
  return LOADING_STATE >= 11
end

-- returns true if done, false if not
function PreloadAndStart()
  if LOADING_STATE == 0 then
    LOCK_INPUT = true
    SetPaused(true)
    LOADING_STATE = 1
    return false
  elseif LOADING_STATE == 1 then
    LOCK_INPUT = true
    AddContentBundle("meshes.bin")
    LOADING_STATE = 2
    return false
  elseif LOADING_STATE == 2 then
    LOCK_INPUT = true
    if PreloadTextureSet() then
      LOADING_STATE = 3
    end
    return false
  elseif LOADING_STATE == 3 then
    LOCK_INPUT = true
    LoadRenderables()
    LOADING_STATE = 4
    return false
  elseif LOADING_STATE == 4 then
    LOCK_INPUT = true
    StartGameState()
  --StartGameSession()
    LOADING_STATE = 5
    return false
  elseif LOADING_STATE < 10 then
    LOCK_INPUT = true
    LOADING_STATE = LOADING_STATE + 1  -- delay for Start()
    return false
  elseif LOADING_STATE == 10 then 
    LOCK_INPUT = true
    LOADING_STATE = 11
    SetPaused(false)    
    StartAudio()
    return false
  elseif LOADING_STATE == 11 and IS_JOINING then
    LOCK_INPUT = true
    SetLoadingMessage("Joining")
    return false
  elseif LOADING_STATE == 11 then
    LOCK_INPUT = false
    RestoreLoadingMessage()
    LOADING_STATE = 12
    return true
  end  
  return true
end
